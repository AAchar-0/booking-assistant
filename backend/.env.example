# Copy to backend/.env for local development (that file is git-ignored) and load it yourself, for example in PowerShell:
#   $env:DATABASE_URL = "postgres://booking:booking@localhost:5432/booking"
# On Render, enter these in the dashboard under Environment. NEVER put real values in this example file.

NODE_ENV=development
PORT=8080

# PostgreSQL connection string. Leave unset in development to run in in-memory demo mode.
DATABASE_URL=

# Long random text, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The website allowed to call this API from a browser (no trailing slash, no path)
ALLOWED_ORIGIN=https://aachar-0.github.io

# AI assistant (optional). Without a key the assistant is switched off and everything else works.
# Choose ONE provider. Keys are secrets: set them only in the Render dashboard, never in a file that is committed.
#
# Option 1, Anthropic (paid): leave AI_PROVIDER empty (or "anthropic") and set the key and model.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
#
# Option 2, Groq (has a free plan): set AI_PROVIDER=groq and AI_API_KEY. AI_MODEL is optional (default llama-3.3-70b-versatile).
# Option 3, any OpenAI-compatible service: AI_PROVIDER=openai-compatible, AI_API_KEY, AI_BASE_URL (https) and AI_MODEL.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
# Only for models that support it, for example openai/gpt-oss-120b on Groq: low, medium or high
AI_REASONING_EFFORT=
AI_DAILY_LIMIT=200
AI_USER_HOURLY_LIMIT=20

# Business and booking rules (all optional)
BUSINESS_NAME=Acacia Studio (demo)
BUSINESS_TZ=Africa/Nairobi
SLOT_STEP_MINUTES=15
MIN_NOTICE_MINUTES=60
MAX_DAYS_AHEAD=60
CANCEL_MIN_HOURS=2
MAX_ACTIVE_BOOKINGS=5

# Used only by "npm run seed" to create the admin account (choose your own, at least 10 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true only if you need client IP addresses in the access log (they are personal data)
LOG_CLIENT_IP=false
